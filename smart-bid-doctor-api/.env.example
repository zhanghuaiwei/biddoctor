# 复制为 .env 并按需修改；生产环境通过部署平台注入，勿提交 .env。
# 全部键与 app/core/config.py Settings 字段一一对应（前缀 FJ_）。

# ── 基础 ─────────────────────────────────────────────
FJ_ENV=dev   # dev | prod（prod 启动强制校验密钥/内部令牌，见 config._prod_guard）
FJ_DATABASE_URL=postgresql+psycopg://smart-bid-doctor:smart-bid-doctor@localhost:5432/smart-bid-doctor
FJ_JWT_SECRET=change-me-to-a-long-random-string   # prod：≥32 字符强随机
FJ_JWT_EXPIRE_DAYS=7
FJ_INTERNAL_TOKEN=                                 # prod 必填；为空则 /internal/* 回退管理员 Bearer

# ── 上传与配额 ───────────────────────────────────────
FJ_UPLOAD_DIR=./data/uploads
FJ_MAX_UPLOAD_MB=100
FJ_MAX_PAGES=500
FJ_FREE_PROJECTS_PER_MONTH=3

# ── 接入与限流 ───────────────────────────────────────
FJ_CORS_ORIGINS=http://localhost:5173              # 逗号分隔；prod 禁止 *
FJ_RATE_LIMIT_PER_MIN=120                          # 每账号+IP 每分钟，0=关闭

# ── 开发便利（仅 dev 生效）────────────────────────────
FJ_DEV_FIXED_CODE=123456                           # dev 环境固定验证码

# ── 商品价目（JSON；订单 SKU 取值域由此驱动）─────────
FJ_SKU_CATALOG={"cmp_x5": {"amount_cny": 99, "title": "对照检查 5 次包"}, "cmp_x20": {"amount_cny": 199, "title": "对照检查 20 次包"}}

# ── LLM Provider（M1 接入真实调用时配置；01·D1 智谱，OpenAI 兼容）─────────
FJ_ZHIPU_API_KEY=
FJ_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FJ_LLM_MODEL_HEAVY=glm-4.6                         # 重任务：条款抽取/对照判定
FJ_LLM_MODEL_LIGHT=glm-4.5-flash                   # 轻任务：分类/摘要/兜底重试
